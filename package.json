{
  "name": "dsh-work-eta",
  "version": "1.0.0",
  "description": "Live estimate of how much longer the running turn needs, drawn from the DSH session log.",
  "type": "module",
  "license": "MIT",
  "author": "caobanheitu",
  "repository": {
    "type": "git",
    "url": "https://github.com/caobanheitu/dsh-work-eta.git"
  },
  "homepage": "https://github.com/caobanheitu/dsh-work-eta#readme",
  "bugs": {
    "url": "https://github.com/caobanheitu/dsh-work-eta/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "eta",
    "progress",
    "todo",
    "session-projection"
  ],
  "scripts": {
    "test": "node test/verify.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "test/verify.mjs"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0-0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
